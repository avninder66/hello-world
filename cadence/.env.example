# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Shared secret for the publisher cron endpoint: openssl rand -hex 24
CRON_SECRET=
# Set to true to run the whole pipeline without posting to real networks
PUBLISH_DRY_RUN=false

# --- Supabase (Project settings → API keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Claude (in-app drafting) -----------------------------------------------
ANTHROPIC_API_KEY=
# CADENCE_AI_MODEL=claude-opus-5-5

# --- Social apps (leave blank to hide a network) ----------------------------
# Redirect URI for each: <APP_URL>/api/connect/<provider>/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_SCOPES="openid profile w_member_social w_organization_social r_organization_admin"
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Bluesky and Mastodon need no app: users connect with an app password / access token.
